#!/usr/bin/env bash
set -euo pipefail

dnf install -y nginx

cat > /usr/share/nginx/html/index.html <<'HTML'
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Terraform AWS HA Web Platform</title>
    <style>
      body { background:#0b1220; color:#e5edf7; font-family:system-ui,sans-serif; margin:0; min-height:100vh; display:grid; place-items:center; }
      main { max-width:720px; padding:3rem; border:1px solid #26344a; border-radius:18px; background:#111b2e; box-shadow:0 24px 70px #0008; }
      h1 { color:#78dce8; } code { color:#a9dc76; }
    </style>
  </head>
  <body><main><p>MODULE 06 · LIVE RESULT</p><h1>Deployment successful</h1><p>This instance is running behind an AWS Application Load Balancer and Auto Scaling group.</p><p>Managed with <code>Terraform</code>.</p></main></body>
</html>
HTML

cat > /etc/nginx/conf.d/health.conf <<'NGINX'
server {
  listen ${application_port} default_server;
  server_name _;
  root /usr/share/nginx/html;
  location = /health { access_log off; add_header Content-Type text/plain; return 200 'healthy'; }
  location / { try_files $uri $uri/ =404; }
}
NGINX

rm -f /etc/nginx/conf.d/default.conf
systemctl enable --now nginx
